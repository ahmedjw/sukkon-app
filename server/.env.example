# --- Required ---
DATABASE_URL="file:./dev.db"          # prod: postgresql://user:pass@host:5432/sukoun
JWT_SECRET="change-me-in-prod-please-this-is-just-a-dev-secret-32chars+"  # prod refuses placeholder values
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*                          # prod requires explicit comma-separated origins, e.g. https://app.sukoun.com

# --- Optional ---
ENABLE_DEV_SOCIAL_AUTH=false           # dev-only demo social login; never honored in production
RESET_TOKEN_TTL_MIN=30                 # password-reset token lifetime (minutes)

# --- Post-launch integrations (seams documented in PRODUCTION_PLAN.md) ---
# SMTP_URL=                            # email dispatch for password reset
# STRIPE_SECRET_KEY=                   # payments
# DAILY_API_KEY=                       # video rooms
# GOOGLE_OAUTH_CLIENT_ID=              # real social sign-in
